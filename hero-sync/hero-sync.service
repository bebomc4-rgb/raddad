[Unit]
Description=HERO STORE supplier sync (mega-game -> herostore-sy)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=raddad
WorkingDirectory=/opt/raddad
ExecStart=/usr/bin/node /opt/raddad/hero-sync/sync.mjs
TimeoutStartSec=900
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/raddad/data
