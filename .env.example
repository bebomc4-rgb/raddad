# انسخ هالملف باسم .env وعدّل القيم

# المنفذ يلي بيشتغل عليه السيرفر
PORT=3000
HOST=127.0.0.1

# الرابط العام للوحة (بعد ما تربط Cloudflare Tunnel) — بدون / بالآخر
PUBLIC_URL=https://app.ko-sport.online

# إيميلك: أي حساب بيتسجل بهالإيميل بيصير مدير المنصة (غير أول حساب)
ADMIN_EMAIL=

# مفتاح التشفير (اتركه فاضي وبينولّد لحاله بملف data/.secret — لا تحذف هالملف أبداً)
APP_SECRET=

# إصدار Graph API للربط الرسمي مع ميتا
GRAPH_VERSION=v23.0

NODE_ENV=production
